{
  "name": "trace-d1-day-one-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Throwaway day-one checks DC-D2, D3, D4, D7 for specs/d1-demo-slice.md. Not part of the pnpm workspace.",
  "scripts": {
    "d4:node": "node --experimental-strip-types scripts/d4-node.ts",
