    "pg": "8.23.0",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@types/node": "22.20.5",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
