select matches(pg_temp.try($$update public.test_versions set status = 'published', content_sha256 = repeat('b', 64) where test_id = 'e1000000-0000-4000-8000-000000000003' and version_no = 2$$), '^42501 TRACE_GUARD', 'publish: a section with no item is refused');
select is(pg_temp.try($$insert into public.item_versions (org_id, test_version_id, section_id, format, position, stem, options, rubric_version_id, origin, content_sha256) select 'a1000000-0000-4000-8000-000000000001', test_version_id, id, 'mcq', 1, 'V4 item.', '[{"id": "o1", "text": "One"}, {"id": "o2", "text": "Two"}]', null, 'human', repeat('c', 64) from public.sections where name = 'V4 Choices'$$), 'OK 1', 'publish: fixture, an mcq item is added');
select matches(pg_temp.try($$update public.test_versions set status = 'published', content_sha256 = repeat('b', 64) where test_id = 'e1000000-0000-4000-8000-000000000003' and version_no = 2$$), '^42501 TRACE_GUARD', 'publish: an mcq item without an answer key is refused');
select is(pg_temp.try($$insert into public.item_answer_keys (org_id, item_version_id, format, key) select 'a1000000-0000-4000-8000-000000000001', id, 'mcq', '{"option_id": "o1"}' from public.item_versions where stem = 'V4 item.'$$), 'OK 1', 'publish: fixture, the key is added');
select matches(pg_temp.try($$update public.test_versions set status = 'published' where test_id = 'e1000000-0000-4000-8000-000000000003' and version_no = 2$$), '^(42501 TRACE_GUARD|23514)', 'publish: a version without content_sha256 is refused');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000007", "aal": "aal2", "amr": [{"method": "otp", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select matches(pg_temp.try($$update public.test_versions set status = 'published' where id = 'f1000000-0000-4000-8000-000000000002'$$), '^42501 permission denied', 'publish: reviewer cannot publish');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000008", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select matches(pg_temp.try($$update public.test_versions set status = 'published' where id = 'f1000000-0000-4000-8000-000000000002'$$), '^42501 permission denied', 'publish: hiring_manager cannot publish');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000004", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select is(pg_temp.try($$update public.test_versions set status = 'published', content_sha256 = repeat('b', 64) where id = 'f1000000-0000-4000-8000-000000000002'$$), 'OK 0', 'publish: admin at aal1 publishes nothing [AT-B6]');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-00000000000e", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is(pg_temp.try($$update public.test_versions set status = 'published', content_sha256 = repeat('b', 64) where id = 'f1000000-0000-4000-8000-000000000002'$$), 'OK 0', 'publish: org B admin publishes nothing in org A (cross-org)');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000009", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select is(pg_temp.try($$update public.test_versions set status = 'published', content_sha256 = repeat('b', 64) where id = 'f1000000-0000-4000-8000-000000000001'$$), 'OK 0', 'publish: workspace recruiter cannot publish a workspace A1 version');
select is(pg_temp.try($$update public.test_versions set status = 'published', content_sha256 = repeat('b', 64) where id = 'f1000000-0000-4000-8000-000000000002'$$), 'OK 1', 'publish: workspace recruiter publishes a complete draft in the workspace A2 (policy passes, L-30)');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000003", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is(pg_temp.try($$update public.test_versions set status = 'published', content_sha256 = repeat('b', 64) where test_id = 'e1000000-0000-4000-8000-000000000003' and version_no = 2$$), 'OK 1', 'publish: admin publishes the completed draft');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000001", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is(pg_temp.try($$update public.test_versions set status = 'published', content_sha256 = repeat('b', 64) where id = 'f1000000-0000-4000-8000-000000000001'$$), 'OK 1', 'publish: owner publishes V1 (written + mcq, rubric and key present)');
select matches(pg_temp.try($$update public.test_versions set status = 'published' where id = 'f1000000-0000-4000-8000-000000000001'$$), '^42501 TRACE_GUARD', 'publish: publishing an already published version is refused (second publisher loses)');
reset role;
reset request.jwt.claims;
select is((select (published_at is not null)::text || '|' || published_by::text from public.test_versions where id = 'f1000000-0000-4000-8000-000000000001'), 'true|00000000-0000-4000-8000-000000000001', 'publish: published_at is stamped and published_by is the publisher');
select is((select pg_temp.keys(a.details) || '|' || (a.details ->> 'version_no') from public.audit_log a where a.action = 'test.publish' and a.object_id = 'f1000000-0000-4000-8000-000000000001'), 'version_no|1', 'event: test.publish carries exactly version_no');
select is((select count(*)::int from public.audit_log where action = 'test.publish' and actor_kind = 'org_user'), 4, 'event: four successful publishes wrote four test.publish rows (V3 fixture + three here); no row for refusals');

-- ===== immutability from publish: authenticated, operator, replica mode =====
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000003", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select matches(pg_temp.try($$update public.test_versions set quality_cutoff = 50 where id = 'f1000000-0000-4000-8000-000000000001'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: the pinned cutoff cannot change after publish');
select matches(pg_temp.try($$update public.test_versions set total_time_seconds = 600 where id = 'f1000000-0000-4000-8000-000000000001'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: the time limit cannot change after publish');
select matches(pg_temp.try($$update public.test_versions set content_sha256 = repeat('e', 64) where id = 'f1000000-0000-4000-8000-000000000001'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: content_sha256 cannot change after publish');
select matches(pg_temp.try($$update public.test_versions set status = 'draft' where id = 'f1000000-0000-4000-8000-000000000001'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: published cannot go back to draft');
select matches(pg_temp.try($$insert into public.sections (org_id, test_version_id, position, name, format, weight) values ('a1000000-0000-4000-8000-000000000001', 'f1000000-0000-4000-8000-000000000003', 2, 'Late', 'mcq', 1)$$), '^(42501|P0001)', 'freeze: a section cannot be added to a published version');
select is(pg_temp.try($$update public.sections set name = 'Late Edit' where id = '51000000-0000-4000-8000-000000000004'$$), 'OK 0', 'freeze: the policy hides published sections from UPDATE');
select is(pg_temp.try($$delete from public.sections where id = '51000000-0000-4000-8000-000000000004'$$), 'OK 0', 'freeze: the policy hides published sections from DELETE');
select is(pg_temp.try($$update public.item_versions set stem = 'Late Edit' where id = '61000000-0000-4000-8000-000000000004'$$), 'OK 0', 'freeze: the policy hides published items from UPDATE');
select is(pg_temp.try($$delete from public.item_answer_keys where item_version_id = '61000000-0000-4000-8000-000000000004'$$), 'OK 0', 'freeze: the policy hides published keys from DELETE');
reset role;
reset request.jwt.claims;
select matches(pg_temp.try($$update public.sections set name = 'Late Edit' where id = '51000000-0000-4000-8000-000000000004'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: postgres (operator) cannot update a published section (no bypass)');
select matches(pg_temp.try($$delete from public.sections where id = '51000000-0000-4000-8000-000000000004'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: postgres cannot delete a published section');
select matches(pg_temp.try($$insert into public.sections (org_id, test_version_id, position, name, format, weight) values ('a1000000-0000-4000-8000-000000000001', 'f1000000-0000-4000-8000-000000000003', 2, 'Late', 'mcq', 1)$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: postgres cannot insert a section into a published version');
select matches(pg_temp.try($$update public.item_versions set stem = 'Late Edit' where id = '61000000-0000-4000-8000-000000000004'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: postgres cannot update a published item');
select matches(pg_temp.try($$delete from public.item_versions where id = '61000000-0000-4000-8000-000000000004'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: postgres cannot delete a published item');
select matches(pg_temp.try($$update public.item_answer_keys set key = '{"option_id": "o2"}' where item_version_id = '61000000-0000-4000-8000-000000000004'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: postgres cannot change a published key');
select matches(pg_temp.try($$delete from public.item_answer_keys where item_version_id = '61000000-0000-4000-8000-000000000004'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: postgres cannot delete a published key');
select matches(pg_temp.try($$update public.test_versions set quality_cutoff = 50 where id = 'f1000000-0000-4000-8000-000000000003'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: postgres cannot change a published cutoff');
select matches(pg_temp.try($$delete from public.test_versions where id = 'f1000000-0000-4000-8000-000000000003'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: postgres cannot delete a published version');
set local role trace_quality_worker;
set local trace.job_org_id = 'a1000000-0000-4000-8000-000000000001';
select matches(pg_temp.try($$update public.sections set name = 'Worker Edit'$$), '^42501 permission denied', 'freeze: the quality worker holds no write privilege on sections (nothing for the freeze trigger to catch)');
select matches(pg_temp.try($$delete from public.item_versions$$), '^42501 permission denied', 'freeze: the quality worker holds no write privilege on item_versions');
reset role;
reset trace.job_org_id;
set local session_replication_role = replica;
select matches(pg_temp.try($$update public.sections set name = 'Late Edit' where id = '51000000-0000-4000-8000-000000000004'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: replica mode (ENABLE ALWAYS) still refuses a published section update');
select matches(pg_temp.try($$update public.item_versions set stem = 'Late Edit' where id = '61000000-0000-4000-8000-000000000004'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: replica mode still refuses a published item update');
select matches(pg_temp.try($$update public.item_answer_keys set key = '{"option_id": "o2"}' where item_version_id = '61000000-0000-4000-8000-000000000004'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: replica mode still refuses a published key update');
select matches(pg_temp.try($$update public.test_versions set quality_cutoff = 50 where id = 'f1000000-0000-4000-8000-000000000003'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: replica mode still refuses a published cutoff update');
select matches(pg_temp.try($$update public.rubric_versions set criteria = '[{"id": "c1", "label": "Changed", "max_points": 9, "anchors": []}]' where rubric_key = 'writing-basic'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'freeze: replica mode still refuses a referenced rubric update');
set local session_replication_role = origin;

-- ===== retire (L-30) and draft delete =====
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000003", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is(pg_temp.try($$update public.test_versions set status = 'retired' where id = 'f1000000-0000-4000-8000-000000000001'$$), 'OK 1', 'retire: admin retires a published version (the policy WITH CHECK does not block it, L-30)');
select is(pg_temp.try($$update public.test_versions set status = 'published' where id = 'f1000000-0000-4000-8000-000000000001'$$), 'OK 0', 'retire: a retired row is not updatable (retired is terminal)');
select matches(pg_temp.try($$update public.test_versions set status = 'retired' where test_id = (select id from public.tests where name = 'Test Four')$$), '^42501 TRACE_GUARD', 'retire: a draft cannot be retired directly (draft -> published -> retired)');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000007", "aal": "aal2", "amr": [{"method": "otp", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select matches(pg_temp.try($$update public.test_versions set status = 'retired' where id = 'f1000000-0000-4000-8000-000000000002'$$), '^42501 permission denied', 'retire: reviewer cannot retire');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000005", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select is(pg_temp.try($$update public.test_versions set status = 'retired' where id = 'f1000000-0000-4000-8000-000000000002'$$), 'OK 1', 'retire: recruiter retires a published version');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-00000000000e", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is(pg_temp.try($$update public.test_versions set status = 'retired' where id = 'f1000000-0000-4000-8000-000000000003'$$), 'OK 0', 'retire: org B admin retires nothing in org A (cross-org)');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000007", "aal": "aal2", "amr": [{"method": "otp", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select matches(pg_temp.try($$delete from public.test_versions where id = 'f1000000-0000-4000-8000-000000000001'$$), '^42501 permission denied', 'test_versions D: reviewer has no DELETE privilege');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000008", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select matches(pg_temp.try($$delete from public.test_versions$$), '^42501 permission denied', 'test_versions D: hiring_manager has no DELETE privilege');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000003", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is(pg_temp.try($$delete from public.test_versions where id = 'f1000000-0000-4000-8000-000000000003'$$), 'OK 0', 'test_versions D: admin cannot delete a published version (the policy admits drafts only)');
select is(pg_temp.try($$delete from public.test_versions where id = 'f1000000-0000-4000-8000-000000000001'$$), 'OK 0', 'test_versions D: admin cannot delete a retired version');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-00000000000e", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is(pg_temp.try($$delete from public.test_versions where test_id = (select id from public.tests where name = 'Test Four')$$), 'OK 0', 'test_versions D: org B admin cannot delete an org A draft (cross-org)');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000001", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is(pg_temp.try($$delete from public.test_versions where test_id = (select id from public.tests where name = 'Test Four')$$), 'OK 1', 'test_versions D: owner deletes a draft version');
reset role;
reset request.jwt.claims;
select is((select count(*)::int from public.ruleset_versions where test_id = (select id from public.tests where name = 'Test Four')), 0, 'test_versions D: deleting a draft also deletes its unpublished ruleset row');
select is((select count(*)::int from public.audit_log where action in ('test.create', 'test.publish') and details::text ~* '(Test Four|Test One|Reviewer|persona|@example)'), 0, 'event: authoring audit details never carry names or emails');

select * from finish();
rollback;
