-- The assigned reviewer persona is assigned to T1 on the operator path (so the S* arm has something to see).
insert into public.assignments (org_id, membership_id, scope, test_id, as_role, created_by)
  select m.org_id, m.id, 'test', 'e1000000-0000-4000-8000-000000000001', 'reviewer', '00000000-0000-4000-8000-000000000001'
  from public.memberships m where m.org_id = 'a1000000-0000-4000-8000-000000000001' and m.user_id = '00000000-0000-4000-8000-000000000007';
-- V3 is published by the admin (plain update; it also makes the recruiter persona the auto-assigned creator of T3).
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000003", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
update public.test_versions set status = 'published', content_sha256 = repeat('b', 64) where id = 'f1000000-0000-4000-8000-000000000003';
reset role;
reset request.jwt.claims;

-- Fixture: T1 (ws A1, owner, V1 complete draft, reviewer assigned), T2 (ws A2, ws recruiter, V2 draft), T3 (ws A1, recruiter, V3 published), TB (org B, VB draft).
-- try() returns 'OK <rows>' or '<sqlstate> <message>'. Freeze refusals match ^(42501 TRACE_GUARD|P0001 TRACE_FROZEN) (SQLSTATE and tag of the freeze/guard triggers are not fixed by the spec; see NOTES.md).

-- ===== tests: S =====
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000001", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is((select count(*)::int from public.tests), 3, 'tests S: org_owner sees the three org A tests (org B hidden)');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000003", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is((select count(*)::int from public.tests), 3, 'tests S: admin sees the three org A tests');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000005", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select is((select count(*)::int from public.tests), 3, 'tests S: recruiter (aal1, email OTP, no workspace scope) sees the three org A tests');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000009", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select is((select array_agg(name) from public.tests), array['Test Two'], 'tests S: workspace-scoped recruiter sees only the workspace A2 test');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000007", "aal": "aal2", "amr": [{"method": "otp", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is((select array_agg(name) from public.tests), array['Test One'], 'tests S: assigned reviewer sees only the assigned test (S*)');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000014", "aal": "aal2", "amr": [{"method": "otp", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is((select count(*)::int from public.tests), 0, 'tests S: unassigned reviewer sees no test');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000007", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select is((select count(*)::int from public.tests), 0, 'tests S: assigned reviewer at aal1 sees no test (aal2 required)');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000008", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select is((select count(*)::int from public.tests), 0, 'tests S: hiring_manager is denied');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000004", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select is((select count(*)::int from public.tests), 0, 'tests S: admin at aal1 sees no test [AT-B6]');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000006", "aal": "aal1", "amr": [{"method": "password", "timestamp": 1760000000}], "role": "authenticated"}';
select is((select count(*)::int from public.tests), 0, 'tests S: password recruiter at aal1 sees no test [AT-B6]');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000011", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select is((select count(*)::int from public.tests), 0, 'tests S: user without a membership sees no test');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-00000000000e", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is((select array_agg(name) from public.tests), array['Test B'], 'tests S: org B admin sees the org B test only (cross-org)');
reset role;
reset request.jwt.claims;
set local role anon;
select matches(pg_temp.try('select * from public.tests'), '^42501 permission denied', 'tests S: anon has no privilege');
reset role;
reset request.jwt.claims;
set local role trace_candidate;
select matches(pg_temp.try('select * from public.tests'), '^42501 permission denied', 'tests S: trace_candidate has no privilege');
reset role;
reset request.jwt.claims;
set local role trace_quality_worker;
set local trace.job_org_id = 'a1000000-0000-4000-8000-000000000001';
select matches(pg_temp.try('select * from public.tests'), '^42501 permission denied', 'tests S: trace_quality_worker has no privilege (matrix cell is denied)');
reset role;
reset trace.job_org_id;

-- ===== tests: I =====
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000001", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is(pg_temp.try($$insert into public.tests (org_id, workspace_id, name) values ('a1000000-0000-4000-8000-000000000001', 'b1000000-0000-4000-8000-000000000001', 'Test Four')$$), 'OK 1', 'tests I: org_owner creates a test');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000003", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select is(pg_temp.try($$insert into public.tests (org_id, workspace_id, name) values ('a1000000-0000-4000-8000-000000000001', 'b1000000-0000-4000-8000-000000000001', 'Test Five')$$), 'OK 1', 'tests I: admin creates a test');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000005", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select is(pg_temp.try($$insert into public.tests (org_id, workspace_id, name) values ('a1000000-0000-4000-8000-000000000001', 'b1000000-0000-4000-8000-000000000001', 'Test Six')$$), 'OK 1', 'tests I: recruiter creates a test');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000009", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select is(pg_temp.try($$insert into public.tests (org_id, workspace_id, name) values ('a1000000-0000-4000-8000-000000000001', 'b1000000-0000-4000-8000-000000000002', 'Test Seven')$$), 'OK 1', 'tests I: workspace recruiter creates a test in the workspace A2');
select matches(pg_temp.try($$insert into public.tests (org_id, workspace_id, name) values ('a1000000-0000-4000-8000-000000000001', 'b1000000-0000-4000-8000-000000000001', 'Test Fence')$$), '^42501', 'tests I: workspace recruiter cannot create a test in workspace A1');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000007", "aal": "aal2", "amr": [{"method": "otp", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select matches(pg_temp.try($$insert into public.tests (org_id, workspace_id, name) values ('a1000000-0000-4000-8000-000000000001', 'b1000000-0000-4000-8000-000000000001', 'Reviewer Test')$$), '^42501', 'tests I: reviewer cannot create a test');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000008", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select matches(pg_temp.try($$insert into public.tests (org_id, workspace_id, name) values ('a1000000-0000-4000-8000-000000000001', 'b1000000-0000-4000-8000-000000000001', 'Hm Test')$$), '^42501', 'tests I: hiring_manager cannot create a test');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000004", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select matches(pg_temp.try($$insert into public.tests (org_id, workspace_id, name) values ('a1000000-0000-4000-8000-000000000001', 'b1000000-0000-4000-8000-000000000001', 'Aal1 Test')$$), '^42501', 'tests I: admin at aal1 cannot create a test [AT-B6]');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-00000000000e", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select matches(pg_temp.try($$insert into public.tests (org_id, workspace_id, name) values ('a1000000-0000-4000-8000-000000000001', 'b1000000-0000-4000-8000-000000000001', 'Cross Org Test')$$), '^42501', 'tests I: org B admin cannot create a test in org A (cross-org)');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000001", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select matches(pg_temp.try($$insert into public.tests (org_id, workspace_id, name) values ('a1000000-0000-4000-8000-000000000003', 'b1000000-0000-4000-8000-000000000004', 'Into B Test')$$), '^42501', 'tests I: org A owner cannot create a test in org B (cross-org)');
select matches(pg_temp.try($$insert into public.tests (org_id, workspace_id, name) values ('a1000000-0000-4000-8000-000000000001', 'b1000000-0000-4000-8000-000000000001', '')$$), '^23514', 'tests I: an empty name violates the length CHECK');
select matches(pg_temp.try($$insert into public.tests (org_id, workspace_id, name) values ('a1000000-0000-4000-8000-000000000001', 'b1000000-0000-4000-8000-000000000001', repeat('x', 201))$$), '^23514', 'tests I: a 201-character name violates the length CHECK');
select matches(pg_temp.try($$insert into public.tests (org_id, workspace_id, name, invitation_seq) values ('a1000000-0000-4000-8000-000000000001', 'b1000000-0000-4000-8000-000000000001', 'Seq Test', 5)$$), '^42501 permission denied', 'tests I: invitation_seq is outside the column grant');
reset role;
reset request.jwt.claims;
set local role trace_candidate;
