set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000005", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select is(pg_temp.try($$insert into public.rubric_versions (org_id, rubric_key, version_no, criteria, content_sha256) values ('a1000000-0000-4000-8000-000000000001', 'writing-extra', 2, '[{"id": "c1", "label": "Clarity", "max_points": 3, "anchors": []}]', repeat('d', 64))$$), 'OK 1', 'rubric_versions I: recruiter adds a new rubric version');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000007", "aal": "aal2", "amr": [{"method": "otp", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select matches(pg_temp.try($$insert into public.rubric_versions (org_id, rubric_key, version_no, criteria, content_sha256) values ('a1000000-0000-4000-8000-000000000001', 'writing-rv', 1, '[{"id": "c1", "label": "Clarity", "max_points": 3, "anchors": []}]', repeat('d', 64))$$), '^42501', 'rubric_versions I: reviewer cannot add a rubric');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000008", "aal": "aal1", "amr": [{"method": "otp", "timestamp": 1760000000}], "role": "authenticated"}';
select matches(pg_temp.try($$insert into public.rubric_versions (org_id, rubric_key, version_no, criteria, content_sha256) values ('a1000000-0000-4000-8000-000000000001', 'writing-hm', 1, '[{"id": "c1", "label": "Clarity", "max_points": 3, "anchors": []}]', repeat('d', 64))$$), '^42501', 'rubric_versions I: hiring_manager cannot add a rubric');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-00000000000e", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select matches(pg_temp.try($$insert into public.rubric_versions (org_id, rubric_key, version_no, criteria, content_sha256) values ('a1000000-0000-4000-8000-000000000001', 'writing-x', 1, '[{"id": "c1", "label": "Clarity", "max_points": 3, "anchors": []}]', repeat('d', 64))$$), '^42501', 'rubric_versions I: org B admin cannot add a rubric to org A (cross-org)');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000001", "aal": "aal2", "amr": [{"method": "password", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select matches(pg_temp.try($$insert into public.rubric_versions (org_id, rubric_key, version_no, criteria, content_sha256) values ('a1000000-0000-4000-8000-000000000001', 'writing-none', 1, '[]', repeat('d', 64))$$), '^23514', 'rubric_versions I: zero criteria violates the 1..8 CHECK');
select matches(pg_temp.try($$insert into public.rubric_versions (org_id, rubric_key, version_no, criteria, content_sha256) values ('a1000000-0000-4000-8000-000000000001', 'writing-nine', 1, (select jsonb_agg(jsonb_build_object('id', 'c' || g, 'label', 'L', 'max_points', 1, 'anchors', jsonb_build_array())) from generate_series(1, 9) g), repeat('d', 64))$$), '^23514', 'rubric_versions I: nine criteria violate the 1..8 CHECK');
select matches(pg_temp.try($$insert into public.rubric_versions (org_id, rubric_key, version_no, criteria, content_sha256) values ('a1000000-0000-4000-8000-000000000001', 'writing-zero', 1, '[{"id": "c1", "label": "Clarity", "max_points": 0, "anchors": []}]', repeat('d', 64))$$), '^23514', 'rubric_versions I: max_points 0 violates max_points > 0');
select matches(pg_temp.try($$insert into public.rubric_versions (org_id, rubric_key, version_no, criteria, content_sha256) values ('a1000000-0000-4000-8000-000000000001', 'writing-extra', 1, '[{"id": "c1", "label": "Clarity", "max_points": 3, "anchors": []}]', repeat('d', 64))$$), '^23505', 'rubric_versions I: a duplicate (rubric_key, version_no) is refused');
select is(pg_temp.try($$update public.rubric_versions set criteria = '[{"id": "c1", "label": "Clarity v2", "max_points": 4, "anchors": []}]' where rubric_key = 'writing-spare'$$), 'OK 1', 'rubric_versions U: an unreferenced rubric can still be edited');
select matches(pg_temp.try($$update public.rubric_versions set criteria = '[{"id": "c1", "label": "Changed", "max_points": 9, "anchors": []}]' where rubric_key = 'writing-basic'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'rubric_versions U: a rubric referenced by an item cannot be updated');
select matches(pg_temp.try($$delete from public.rubric_versions where rubric_key = 'writing-spare'$$), '^42501 permission denied', 'rubric_versions D: no DELETE privilege (matrix SIU, no D)');
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-4000-8000-000000000007", "aal": "aal2", "amr": [{"method": "otp", "timestamp": 1760000000}, {"method": "totp", "timestamp": 1760000100}], "role": "authenticated"}';
select matches(pg_temp.try($$update public.rubric_versions set criteria = '[{"id": "c1", "label": "Reviewer", "max_points": 4, "anchors": []}]' where rubric_key = 'writing-spare'$$), '^42501 permission denied', 'rubric_versions U: reviewer has no UPDATE privilege');
reset role;
reset request.jwt.claims;
select matches(pg_temp.try($$delete from public.rubric_versions where rubric_key = 'writing-basic'$$), '^(42501 TRACE_GUARD|P0001 TRACE_FROZEN)', 'rubric_versions D: even the operator cannot delete a referenced rubric (no bypass)');

