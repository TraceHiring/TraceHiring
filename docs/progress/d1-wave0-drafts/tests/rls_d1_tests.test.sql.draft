select matches(pg_temp.try($$insert into public.item_answer_keys (org_id, item_version_id, format, key) values ('a1000000-0000-4000-8000-000000000001', '61000000-0000-4000-8000-000000000002', 'mcq', '{"option_id": "o1"}')$$), '^42501', 'item_answer_keys I: org B admin cannot insert a key on an org A item (cross-org)');
set local role authenticated;
