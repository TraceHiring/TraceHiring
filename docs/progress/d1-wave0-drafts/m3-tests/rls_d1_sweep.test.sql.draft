-- SE: the quality card arrives after its integrity card was parked as awaiting_quality.
insert into quality.scores (id, org_id, session_id, test_version_id, score, section_scores, quality_cutoff, meets_cutoff, scoring_version, rubric_set_sha256, rubric_version_ids, grader_model_id, grader_adapter_version, computed_at) values ('a5000000-0000-4000-8000-000000000005', 'a1000000-0000-4000-8000-000000000001', 'a4000000-0000-4000-8000-000000000005', 'f1000000-0000-4000-8000-000000000001', 80, '[{"position": 1, "weight": 1, "score": 80}]', 40, true, 'd1-scoring-v1', repeat('d', 64), '{}', 'mock-grader-v1', 'mock-1', '2026-10-14 10:21:00+00');
insert into public.quality_cards (org_id, session_id, quality_score_id) values ('a1000000-0000-4000-8000-000000000001', 'a4000000-0000-4000-8000-000000000005', 'a5000000-0000-4000-8000-000000000005');
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
create temp table sweep_snap as select (select count(*) from public.idempotency_keys)::text || '/' || (select count(*) from public.sessions) || '/' || (select count(*) from public.quality_cards) || '/' || (select count(*) from public.integrity_cards) || '/' || (select count(*) from public.invitations) as v;
-- ===== private.sweep_pending: STABLE DEFINER, search_path = '', EXECUTE to trace_worker only (L-18, MT-7) =====
select ok((select to_regprocedure('private.sweep_pending(integer)') is not null), 'sweep_pending: private.sweep_pending(integer) exists');
select is((select prosecdef from pg_proc where oid = 'private.sweep_pending(integer)'::regprocedure), true, 'sweep_pending: SECURITY DEFINER');
select is((select provolatile::text from pg_proc where oid = 'private.sweep_pending(integer)'::regprocedure), 's', 'sweep_pending: STABLE');
select is((select proconfig @> array['search_path=""'] from pg_proc where oid = 'private.sweep_pending(integer)'::regprocedure), true, 'sweep_pending: search_path is pinned to the empty path (MT-7)');
select is((select string_agg(g, ',' order by g) from (select distinct coalesce(r.rolname, 'PUBLIC') as g from pg_proc p, aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) a left join pg_roles r on r.oid = a.grantee where p.oid = 'private.sweep_pending(integer)'::regprocedure and a.privilege_type = 'EXECUTE') s), 'postgres,trace_worker', 'sweep_pending: EXECUTE is held by the owner and trace_worker only (not PUBLIC)');
select is((select coalesce(string_agg(r, ',' order by r), '') from unnest(array['anon', 'authenticated', 'service_role', 'trace_api', 'trace_quality_worker', 'trace_integrity_worker', 'trace_candidate', 'trace_candidate_gateway']) r where has_function_privilege(r, 'private.sweep_pending(integer)', 'execute')), '', 'sweep_pending: no other role may execute it');
select is((select prosrc ~ '(^|[^a-z_])(quality|integrity)[.][a-z_]' from pg_proc where oid = 'private.sweep_pending(integer)'::regprocedure), false, 'sweep_pending: the body names neither quality.* nor integrity.* (reads public tables only, MT-5)');
select is((select has_schema_privilege('trace_worker', 'private', 'USAGE')), true, 'sweep_pending: trace_worker can reach the private schema');
-- ===== EXECUTE denied to every other role =====
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
set local role authenticated;
select matches(pg_temp.try($$select * from private.sweep_pending(5)$$), '^42501 permission denied', 'sweep_pending: authenticated cannot call it');
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
set local role anon;
select matches(pg_temp.try($$select * from private.sweep_pending(5)$$), '^42501 permission denied', 'sweep_pending: anon cannot call it');
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
set local role service_role;
select matches(pg_temp.try($$select * from private.sweep_pending(5)$$), '^42501 permission denied', 'sweep_pending: service_role cannot call it');
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
set local role trace_api;
select matches(pg_temp.try($$select * from private.sweep_pending(5)$$), '^42501 permission denied', 'sweep_pending: trace_api cannot call it');
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
set local role trace_quality_worker;
select matches(pg_temp.try($$select * from private.sweep_pending(5)$$), '^42501 permission denied', 'sweep_pending: trace_quality_worker cannot call it');
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
set local role trace_integrity_worker;
select matches(pg_temp.try($$select * from private.sweep_pending(5)$$), '^42501 permission denied', 'sweep_pending: trace_integrity_worker cannot call it');
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
set local role trace_candidate;
select matches(pg_temp.try($$select * from private.sweep_pending(5)$$), '^42501 permission denied', 'sweep_pending: trace_candidate cannot call it');
-- ===== behaviour: three stages for crafted states, nothing for complete sessions =====
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
set local role trace_worker;
select matches(pg_temp.try($$select org_id, session_id, ruleset_version_id, stage from private.sweep_pending(1) limit 0$$), '^OK 0$', 'sweep_pending: returns (org_id, session_id, ruleset_version_id, stage)');
select is((select string_agg(stage || ':' || org_id || ':' || session_id, ',' order by (stage || ':' || org_id || ':' || session_id) collate "C") from private.sweep_pending(1000) where session_id not in ('a4000000-0000-4000-8000-000000000001', 'a4000000-0000-4000-8000-000000000040')), 'integrity_band:a1000000-0000-4000-8000-000000000001:a4000000-0000-4000-8000-000000000002,integrity_band:a1000000-0000-4000-8000-000000000001:a4000000-0000-4000-8000-000000000005,quality_score:a1000000-0000-4000-8000-000000000001:a4000000-0000-4000-8000-000000000004,session_mirror:a1000000-0000-4000-8000-000000000001:a4000000-0000-4000-8000-000000000011,session_mirror:a1000000-0000-4000-8000-000000000003:a4000000-0000-4000-8000-000000000013', 'sweep_pending: exactly the crafted stalled stages (Sb and SE integrity_band, SD quality_score, X1 and X3 session_mirror), cross-org rows carry their own org_id');
select is((select count(*)::int from private.sweep_pending(1000) where stage = 'session_mirror'), 2, 'sweep_pending: session_mirror lists only the started invitations without a sessions row whose deadline is long past (X1, X3)');
select is((select count(*)::int from private.sweep_pending(1000) where session_id = 'a4000000-0000-4000-8000-000000000012'), 0, 'sweep_pending: a freshly started invitation (deadline not yet past) is not listed');
select is((select count(*)::int from private.sweep_pending(1000) where stage = 'quality_score' and session_id = 'a4000000-0000-4000-8000-000000000001' and org_id = 'a1000000-0000-4000-8000-000000000001'), 1, 'sweep_pending: a session with no cards at all is listed for quality_score');
select is((select count(*)::int from private.sweep_pending(1000) where stage = 'quality_score' and session_id = 'a4000000-0000-4000-8000-000000000040' and org_id = 'a1000000-0000-4000-8000-000000000003'), 1, 'sweep_pending: an org B session with no cards is listed for quality_score under org B');
select is((select count(*)::int from private.sweep_pending(1000) where session_id in ('a4000000-0000-4000-8000-000000000003', 'a4000000-0000-4000-8000-000000000006')), 0, 'sweep_pending: complete sessions (reviewed card, and below-cutoff card) produce no row');
select is((select count(*)::int from private.sweep_pending(1000) where session_id = 'a4000000-0000-4000-8000-000000000005' and stage <> 'integrity_band'), 0, 'sweep_pending: an awaiting_quality card whose quality card now exists is an integrity_band row only');
select is((select count(*)::int from private.sweep_pending(1000) where session_id = 'a4000000-0000-4000-8000-000000000004' and stage <> 'quality_score'), 0, 'sweep_pending: an awaiting_quality card with no quality card yet waits for quality_score only');
select is((select count(*)::int from private.sweep_pending(1000) where ruleset_version_id is distinct from (case org_id when 'a1000000-0000-4000-8000-000000000001' then pg_temp.rs('f1000000-0000-4000-8000-000000000001') else pg_temp.rs('f1000000-0000-4000-8000-00000000000b') end)), 0, 'sweep_pending: every row carries the ruleset version pinned by its test version');
-- p_limit
select is((select count(*)::int from private.sweep_pending(2)), 2, 'sweep_pending: p_limit 2 returns two rows');
select is((select count(*)::int from private.sweep_pending(1)), 1, 'sweep_pending: p_limit 1 returns one row');
select is((select count(*)::int from private.sweep_pending(0)), 0, 'sweep_pending: p_limit 0 returns no row');
select ok((select count(*) >= 7 from private.sweep_pending(1000)), 'sweep_pending: a large p_limit returns every stalled stage');
-- the sweep is called by the jobs cron; whether a set job org filters it is an open question (NOTES), so only that the call works is asserted
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
set local role trace_worker;
set local trace.job_org_id = 'a1000000-0000-4000-8000-000000000001';
select matches(pg_temp.try($$select * from private.sweep_pending(5)$$), '^OK 5$', 'sweep_pending: callable with a job org set (it is a cron sweep across orgs, see NOTES)');
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
select is((select (select count(*) from public.idempotency_keys)::text || '/' || (select count(*) from public.sessions) || '/' || (select count(*) from public.quality_cards) || '/' || (select count(*) from public.integrity_cards) || '/' || (select count(*) from public.invitations)), (select v from sweep_snap), 'sweep_pending: it writes nothing (idempotency keys, sessions, cards and invitations unchanged)');
-- ===== convergence: finishing a stage removes its row; a stored sessions row moves the session to the next stage =====
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
set local role trace_integrity_worker;
set local trace.job_org_id = 'a1000000-0000-4000-8000-000000000001';
insert into integrity.results (id, org_id, session_id, ruleset_version_id, band_rule_version_id, engine_version, band, evidence_strength, coverage_permille, coverage_floor_permille, photo_missing, input_hash, computed_at) values ('a6000000-0000-4000-8000-000000000002', 'a1000000-0000-4000-8000-000000000001', 'a4000000-0000-4000-8000-000000000002', (select ruleset_version_id from public.sessions where id = 'a4000000-0000-4000-8000-000000000002'), (select r.band_rule_version_id from public.ruleset_versions r where r.id = (select ruleset_version_id from public.sessions where id = 'a4000000-0000-4000-8000-000000000002')), 'band-engine-1', 'clear', 1.00, 900, 700, false, repeat('e', 64), '2026-10-14 10:22:00+00');
insert into public.integrity_cards (org_id, session_id, integrity_result_id, review_state, photo_missing) values ('a1000000-0000-4000-8000-000000000001', 'a4000000-0000-4000-8000-000000000002', 'a6000000-0000-4000-8000-000000000002', 'reviewed', false);
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
set local role trace_worker;
set local trace.job_org_id = 'a1000000-0000-4000-8000-000000000001';
insert into public.sessions (id, org_id, workspace_id, test_id, test_version_id, ruleset_version_id, invitation_id, consent_id, state, submit_kind, submitted_at, adult_confirmed_at_start, started_at, server_deadline_at, mirror_seq, receipt_ref) values
  ('a4000000-0000-4000-8000-000000000011', 'a1000000-0000-4000-8000-000000000001', 'b1000000-0000-4000-8000-000000000001', 'e1000000-0000-4000-8000-000000000001', 'f1000000-0000-4000-8000-000000000001', pg_temp.rs('f1000000-0000-4000-8000-000000000001'), 'a2000000-0000-4000-8000-000000000011', 'a3000000-0000-4000-8000-000000000011', 'submitted', 'candidate', '2020-01-01 10:20:00+00', true, '2020-01-01 10:00:00+00', '2020-01-01 10:31:00+00', 1, 'RCPT0011');
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;
set local role trace_worker;
select is((select count(*)::int from private.sweep_pending(1000) where session_id = 'a4000000-0000-4000-8000-000000000002'), 0, 'sweep_pending: once Sb has its integrity card the session is complete and drops out');
select is((select count(*)::int from private.sweep_pending(1000) where stage = 'session_mirror' and session_id = 'a4000000-0000-4000-8000-000000000011'), 0, 'sweep_pending: once X1 has a sessions row it is no longer a session_mirror row');
select is((select count(*)::int from private.sweep_pending(1000) where stage = 'quality_score' and session_id = 'a4000000-0000-4000-8000-000000000011'), 1, 'sweep_pending: X1 moves on to quality_score (no quality card yet)');
reset role;
reset request.jwt.claims;
reset trace.job_org_id;
reset trace.api_org_id;

select * from finish();
rollback;
