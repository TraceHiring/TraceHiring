-- Smoke for the D1 migration 2 draft (not a pgTAP file; rolled back). Run AFTER the migration-1 draft (only if
-- public.tests does not exist yet) and the migration-2 draft, inside the same transaction, as postgres:
--   begin; [m1 draft] ; m2 draft ; this file ; rollback;
-- Every case records (name, got, want) in a temp table; a case passes when got LIKE want. The last two queries print
-- the pass/fail counts and every failing case. Synthetic personas only (fixed uuids, @example.test addresses).

set local statement_timeout = '120s';
set local lock_timeout = '60s';
create temp table smoke (ts timestamptz not null default clock_timestamp(), name text, got text, want text);
grant select, insert on smoke to public;
create function pg_temp.try(p_sql text) returns text language plpgsql as $f$
declare n bigint;
begin
  execute p_sql;
  get diagnostics n = row_count;
  return 'OK ' || n;
exception when others then
  return sqlstate || ' ' || sqlerrm;
end
$f$;
grant execute on function pg_temp.try(text) to public;
create function pg_temp.val(p_sql text) returns text language plpgsql as $f$
declare r text;
begin
  execute p_sql into r;
  return coalesce(r, '<null>');
exception when others then
  return sqlstate || ' ' || sqlerrm;
end
$f$;
grant execute on function pg_temp.val(text) to public;
create function pg_temp.chk(p_name text, p_got text, p_want text) returns void language sql as $f$
  insert into pg_temp.smoke (name, got, want) values (p_name, p_got, p_want)
$f$;
grant execute on function pg_temp.chk(text, text, text) to public;
grant trace_api to postgres with inherit false, set true;
grant trace_worker to postgres with inherit false, set true;
grant trace_quality_worker to postgres with inherit false, set true;
grant trace_integrity_worker to postgres with inherit false, set true;

