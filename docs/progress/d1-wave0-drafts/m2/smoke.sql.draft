-- D. Mirror (trace_worker): invitation submitted guard, mirror_session idempotency, sessions guard, children
-- ---------------------------------------------------------------------------------------------
create temp table msg as select jsonb_build_object(
  'v', 1, 'jobKind', 'session_mirror', 'mirrorSeq', 1,
  'jobKey', 'aa000000-0000-4000-8000-000000000001:session_mirror:d1000000-0000-4000-8000-000000000001',
  'sessionId', 'aa000000-0000-4000-8000-000000000001', 'orgId', 'a1000000-0000-4000-8000-000000000001',
  'invitationId', '11000000-0000-4000-8000-000000000001', 'testVersionId', 'f1000000-0000-4000-8000-000000000001',
  'rulesetVersionId', 'd1000000-0000-4000-8000-000000000001', 'consentId', 'cc000000-0000-4000-8000-000000000001',
  'state', 'submitted', 'receiptRef', 'ABCDEFGH',
  'startedAt', '2026-10-14T10:00:00Z', 'deadlineAt', '2026-10-14T10:10:00Z', 'submittedAt', '2026-10-14T10:08:00Z',
  'lastEventSeq', 12, 'streamCount', 1, 'resumeCount', 0,
  'served', jsonb_build_array(
    jsonb_build_object('position', 1, 'itemVersionId', '91000000-0000-4000-8000-000000000001', 'servedAt', '2026-10-14T10:00:05Z'),
    jsonb_build_object('position', 1, 'itemVersionId', '91000000-0000-4000-8000-000000000002', 'servedAt', '2026-10-14T10:01:00Z')),
  'evidence', jsonb_build_object('finalKey', 'k', 'finalSha256', repeat('f', 64), 'eventsKey', 'k2', 'eventsSha256', repeat('f', 64)),
  'replay', 'ok', 'signalCatalogVersion', 'd1-v1',
  'coverage', jsonb_build_object('activeMs', 480000, 'coveredMs', 470000), 'gaps', '[]'::jsonb,
  'photo', jsonb_build_object('key', 'media/a1000000-0000-4000-8000-000000000001/aa000000-0000-4000-8000-000000000001/start_photo.jpg',
    'sha256', repeat('b', 64), 'bytes', 40000, 'mime', 'image/jpeg', 'blurredOnDevice', true),
  'photoSkippedReason', null,
  'responses', jsonb_build_array(
    jsonb_build_object('itemVersionId', '91000000-0000-4000-8000-000000000001', 'kind', 'choice', 'choice', 'a', 'sha256', repeat('1', 64), 'finalSeq', 3),
    jsonb_build_object('itemVersionId', '91000000-0000-4000-8000-000000000002', 'kind', 'text', 'text', 'Synthetic answer', 'sha256', repeat('2', 64), 'finalSeq', 11))
) as m;
grant select on msg to public;

