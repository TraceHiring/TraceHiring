select pg_temp.chk('F1 mirror worker, org unset: insert refused', pg_temp.try($q$ insert into public.idempotency_keys (org_id, scope, key, expires_at) values ('a1000000-0000-4000-8000-000000000001', 'session_mirror', 's:session_mirror:r', '2030-01-01') $q$), '42501%row-level%');
select set_config('trace.job_org_id', 'a1000000-0000-4000-8000-000000000001', true);
select pg_temp.chk('F2 mirror worker inserts its own scope', pg_temp.try($q$ insert into public.idempotency_keys (org_id, scope, key, expires_at) values ('a1000000-0000-4000-8000-000000000001', 'session_mirror', 's:session_mirror:r', '2030-01-01') $q$), 'OK 1');
select pg_temp.chk('F3 duplicate is on conflict do nothing', pg_temp.try($q$ insert into public.idempotency_keys (org_id, scope, key, expires_at) values ('a1000000-0000-4000-8000-000000000001', 'session_mirror', 's:session_mirror:r', '2030-01-01') on conflict do nothing $q$), 'OK 0');
select pg_temp.chk('F4 mirror worker cannot write quality_score', pg_temp.try($q$ insert into public.idempotency_keys (org_id, scope, key, expires_at) values ('a1000000-0000-4000-8000-000000000001', 'quality_score', 's:quality_score:r', '2030-01-01') $q$), '42501%row-level%');
select pg_temp.chk('F5 mirror worker cannot write org B', pg_temp.try($q$ insert into public.idempotency_keys (org_id, scope, key, expires_at) values ('a1000000-0000-4000-8000-000000000003', 'session_mirror', 's2:session_mirror:r', '2030-01-01') $q$), '42501%row-level%');
select pg_temp.chk('F6 mirror worker UPDATE revoked', pg_temp.try($q$ update public.idempotency_keys set result_ref = 'x' $q$), '42501%permission denied%');
select pg_temp.chk('F7 mirror worker DELETE revoked', pg_temp.try($q$ delete from public.idempotency_keys $q$), '42501%permission denied%');
reset role;
set local role trace_quality_worker;
select pg_temp.chk('F8 quality worker inserts quality_score', pg_temp.try($q$ insert into public.idempotency_keys (org_id, scope, key, expires_at) values ('a1000000-0000-4000-8000-000000000001', 'quality_score', 's:quality_score:r', '2030-01-01') $q$), 'OK 1');
select pg_temp.chk('F9 quality worker cannot write session_mirror', pg_temp.try($q$ insert into public.idempotency_keys (org_id, scope, key, expires_at) values ('a1000000-0000-4000-8000-000000000001', 'session_mirror', 'q:session_mirror:r', '2030-01-01') $q$), '42501%row-level%');
select pg_temp.chk('F10 quality worker sees only its scope', pg_temp.val($q$ select string_agg(distinct scope, ',') from public.idempotency_keys $q$), 'quality_score');
select pg_temp.chk('F11 quality worker UPDATE denied', pg_temp.try($q$ update public.idempotency_keys set result_ref = 'x' $q$), '42501%permission denied%');
select pg_temp.chk('F12 quality worker reads session ids, not times', pg_temp.try($q$ select started_at from public.sessions $q$), '42501%');
select pg_temp.chk('F13 quality worker reads session state', pg_temp.val($q$ select state from public.sessions $q$), 'submitted');
select pg_temp.chk('F14 quality worker reads responses', pg_temp.val($q$ select count(*) from public.responses $q$), '2');
reset role;
set local role trace_integrity_worker;
select pg_temp.chk('F15 integrity worker inserts integrity_band', pg_temp.try($q$ insert into public.idempotency_keys (org_id, scope, key, expires_at) values ('a1000000-0000-4000-8000-000000000001', 'integrity_band', 's:integrity_band:r', '2030-01-01') $q$), 'OK 1');
select pg_temp.chk('F16 integrity worker cannot write quality_score', pg_temp.try($q$ insert into public.idempotency_keys (org_id, scope, key, expires_at) values ('a1000000-0000-4000-8000-000000000001', 'quality_score', 'i:quality_score:r', '2030-01-01') $q$), '42501%row-level%');
select pg_temp.chk('F17 integrity worker cannot read responses', pg_temp.try($q$ select 1 from public.responses $q$), '42501%');
select pg_temp.chk('F18 integrity worker reads sessions', pg_temp.val($q$ select count(*) from public.sessions $q$), '1');
reset role;
set local role authenticated;
set local request.jwt.claims = '{"sub":"00000000-0000-4000-8000-000000000001","aal":"aal2","amr":[{"method":"password","timestamp":1},{"method":"totp","timestamp":2}],"role":"authenticated"}';
select pg_temp.chk('F19 org user cannot touch idempotency_keys', pg_temp.try($q$ select 1 from public.idempotency_keys $q$), '42501%');
reset role;
select pg_temp.chk('F20 old literal-true policies gone', (select count(*)::text from pg_policies where tablename = 'idempotency_keys' and (qual = 'true' or with_check = 'true')), '0');
select pg_temp.chk('F21 six scoped policies', (select count(*)::text from pg_policies where tablename = 'idempotency_keys'), '6');

-- ---------------------------------------------------------------------------------------------
-- G. App-role reads of the session tables
-- ---------------------------------------------------------------------------------------------
set local role authenticated;
set local request.jwt.claims = '{"sub":"00000000-0000-4000-8000-000000000005","aal":"aal1","amr":[{"method":"otp","timestamp":1}],"role":"authenticated"}';
select pg_temp.chk('G1 recruiter sees the session', pg_temp.val($q$ select count(*) from public.sessions $q$), '1');
select pg_temp.chk('G2 recruiter sees consent', pg_temp.val($q$ select count(*) from public.consents $q$), '1');
select pg_temp.chk('G3 recruiter sees session items', pg_temp.val($q$ select count(*) from public.session_items $q$), '2');
select pg_temp.chk('G4 recruiter sees media metadata', pg_temp.val($q$ select bytes from public.media_objects $q$), '40000');
select pg_temp.chk('G5 recruiter cannot read r2_key', pg_temp.try($q$ select r2_key from public.media_objects $q$), '42501%');
select pg_temp.chk('G6 recruiter cannot read sha256', pg_temp.try($q$ select sha256 from public.media_objects $q$), '42501%');
select pg_temp.chk('G7 recruiter cannot read responses (R-8)', pg_temp.try($q$ select 1 from public.responses $q$), '42501%');
select pg_temp.chk('G8 recruiter cannot write sessions', pg_temp.try($q$ update public.sessions set mirror_seq = 9 $q$), '42501%');
select pg_temp.chk('G9 recruiter cannot insert consents', pg_temp.try($q$ insert into public.consents (org_id) values ('a1000000-0000-4000-8000-000000000001') $q$), '42501%');
set local request.jwt.claims = '{"sub":"00000000-0000-4000-8000-000000000006","aal":"aal1","amr":[{"method":"password","timestamp":1}],"role":"authenticated"}';
select pg_temp.chk('G10 unknown user sees no session', pg_temp.val($q$ select count(*) from public.sessions $q$), '0');
set local request.jwt.claims = '{"sub":"00000000-0000-4000-8000-000000000007","aal":"aal2","amr":[{"method":"password","timestamp":1},{"method":"totp","timestamp":2}],"role":"authenticated"}';
select pg_temp.chk('G11 assigned reviewer sees the session', pg_temp.val($q$ select count(*) from public.sessions $q$), '1');
select pg_temp.chk('G12 assigned reviewer sees media metadata', pg_temp.val($q$ select count(*) from public.media_objects $q$), '1');
set local request.jwt.claims = '{"sub":"00000000-0000-4000-8000-000000000007","aal":"aal1","amr":[{"method":"password","timestamp":1}],"role":"authenticated"}';
select pg_temp.chk('G13 reviewer at aal1 sees nothing', pg_temp.val($q$ select count(*) from public.sessions $q$), '0');
set local request.jwt.claims = '{"sub":"00000000-0000-4000-8000-000000000014","aal":"aal2","amr":[{"method":"password","timestamp":1},{"method":"totp","timestamp":2}],"role":"authenticated"}';
select pg_temp.chk('G14 unassigned reviewer sees no session', pg_temp.val($q$ select count(*) from public.sessions $q$), '0');
set local request.jwt.claims = '{"sub":"00000000-0000-4000-8000-000000000008","aal":"aal2","amr":[{"method":"password","timestamp":1},{"method":"totp","timestamp":2}],"role":"authenticated"}';
select pg_temp.chk('G15 hm sees no session', pg_temp.val($q$ select count(*) from public.sessions $q$), '0');
select pg_temp.chk('G16 hm sees no consent', pg_temp.val($q$ select count(*) from public.consents $q$), '0');
reset role;
set local role anon;
select pg_temp.chk('G17 anon denied on invitations', pg_temp.try($q$ select 1 from public.invitations $q$), '42501%');
select pg_temp.chk('G18 anon denied on sessions', pg_temp.try($q$ select 1 from public.sessions $q$), '42501%');
reset role;
select pg_temp.chk('G19 trace_candidate holds nothing on the new tables', (select count(*)::text from information_schema.role_table_grants where grantee in ('trace_candidate', 'trace_candidate_gateway', 'anon') and table_name in ('invitations','consents','sessions','session_items','responses','media_objects')), '0');
select pg_temp.chk('G20 no score/band/grade/outcome/reject column in the new tables', (select count(*)::text from information_schema.columns where table_schema = 'public' and table_name in ('invitations','consents','sessions','session_items','responses','media_objects') and column_name ~ '(score|band|grade|outcome|reject)'), '0');
select pg_temp.chk('G21 invitation_status has no reject label', (select count(*)::text from pg_enum where enumtypid = 'public.invitation_status'::regtype and enumlabel like '%reject%'), '0');
select pg_temp.chk('G22 all new guards ENABLE ALWAYS', (select string_agg(tgname || '=' || tgenabled, ',' order by tgname) from pg_trigger where tgrelid in ('public.invitations'::regclass, 'public.consents'::regclass, 'public.sessions'::regclass, 'public.session_items'::regclass, 'public.responses'::regclass, 'public.media_objects'::regclass) and not tgisinternal and tgenabled <> 'A' and tgname <> 'invitations_audit'), '<null>');
select pg_temp.chk('G23 mirror_session EXECUTE only trace_worker', (select string_agg(r, ',' order by r) from unnest(array['anon','authenticated','service_role','trace_api','trace_worker','trace_quality_worker','trace_integrity_worker']) as r where has_function_privilege(r, 'private.mirror_session(uuid,jsonb)', 'execute')), 'trace_worker');
select pg_temp.chk('G24 no private function executable by trace_api/trace_worker beyond the list', (select coalesce(string_agg(distinct p.proname || ':' || r, ',' order by p.proname || ':' || r), '<none>') from pg_proc as p join pg_namespace as n on n.oid = p.pronamespace cross join unnest(array['trace_api','trace_worker']) as r where n.nspname = 'private' and has_function_privilege(r, p.oid, 'execute')), 'api_org_id:trace_api,job_org_id:trace_worker,mirror_session:trace_worker,resolve_invitation_by_hash:trace_api');

-- ---------------------------------------------------------------------------------------------
-- Result
-- ---------------------------------------------------------------------------------------------
select 'PASS ' || count(*) filter (where got like want) || ' / FAIL ' || count(*) filter (where got not like want) || ' / TOTAL ' || count(*) from smoke;
select 'FAIL ' || name || ' | got: ' || got || ' | want: ' || want from smoke where got not like want order by ts;
