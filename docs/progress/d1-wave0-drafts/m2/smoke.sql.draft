-- ---------------------------------------------------------------------------------------------
-- E. Consents append-only (revoke first, then the trigger in normal and replica mode)
-- ---------------------------------------------------------------------------------------------
select pg_temp.chk('E1 owner UPDATE revoked', pg_temp.try($q$ update public.consents set language = 'en' $q$), '42501%permission denied%');
select pg_temp.chk('E2 owner DELETE revoked', pg_temp.try($q$ delete from public.consents $q$), '42501%permission denied%');
select pg_temp.chk('E3 owner TRUNCATE revoked', pg_temp.try($q$ truncate public.consents cascade $q$), '42501%permission denied%');
grant update, delete, truncate on public.consents to postgres;
select pg_temp.chk('E4 trigger blocks UPDATE', pg_temp.try($q$ update public.consents set language = 'en' $q$), 'P0001 TRACE_APPEND_ONLY');
select pg_temp.chk('E5 trigger blocks DELETE', pg_temp.try($q$ delete from public.consents $q$), 'P0001 TRACE_APPEND_ONLY');
select pg_temp.chk('E6 trigger blocks TRUNCATE', pg_temp.try($q$ truncate public.consents cascade $q$), 'P0001 TRACE_APPEND_ONLY');
select pg_temp.chk('E7 replica mode can be set', pg_temp.try($q$ set local session_replication_role = replica $q$), 'OK%');
select pg_temp.chk('E8 replica: trigger blocks UPDATE', pg_temp.try($q$ update public.consents set language = 'en' $q$), 'P0001 TRACE_APPEND_ONLY');
select pg_temp.chk('E9 replica: trigger blocks DELETE', pg_temp.try($q$ delete from public.consents $q$), 'P0001 TRACE_APPEND_ONLY');
select pg_temp.chk('E10 replica: trigger blocks TRUNCATE', pg_temp.try($q$ truncate public.consents cascade $q$), 'P0001 TRACE_APPEND_ONLY');
select pg_temp.chk('E11 replica: invitation guard still fires', pg_temp.try($q$ update public.invitations set status = 'sent' where id = '11000000-0000-4000-8000-000000000001' $q$), '42501%');
select pg_temp.chk('E12 replica: session guard still fires', pg_temp.try($q$ update public.sessions set mirror_seq = 9 $q$), '42501%');
select pg_temp.chk('E13 replica: invitation label trigger still fires', pg_temp.try($q$
  insert into public.invitations (org_id, test_id, test_version_id, contact_email, link_token_hash, expires_at)
  values ('a1000000-0000-4000-8000-000000000001', 'e1000000-0000-4000-8000-000000000001', 'f1000000-0000-4000-8000-000000000001',
          'cand.r@example.test', repeat('f', 64), '2030-01-01')$q$), '42501%org users only%');
set local session_replication_role = origin;
revoke update, delete, truncate on public.consents from postgres;
select pg_temp.chk('E14 consents count unchanged', (select count(*)::text from public.consents), '1');

