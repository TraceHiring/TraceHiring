{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "SUPERPOWERS_DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Bash(cat .env:*)",
      "Bash(cat .env.*:*)",
      "Bash(less .env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(source .env:*)",
      "Bash(printenv:*)",
      "Bash(wrangler deploy --env production:*)",
      "Bash(wrangler deploy --env=production:*)",
      "Bash(wrangler deploy -e production:*)",
      "Bash(npx wrangler deploy --env production:*)",
      "Bash(pnpm exec wrangler deploy --env production:*)",
      "Bash(pnpm dlx wrangler deploy --env production:*)",
      "Bash(wrangler secret put --env production:*)",
      "Bash(supabase db push --linked:*)",
      "Bash(supabase db push --db-url:*)",
      "Bash(supabase db reset --linked:*)",
      "Bash(supabase link --project-ref:*)",
      "Bash(pnpm run deploy:prod:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push -d:*)",
      "Bash(wrangler deploy --env staging:*)",
      "Bash(wrangler deploy -e staging:*)",
      "Bash(pnpm exec wrangler deploy:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(wrangler pages deploy:*)",
      "Bash(supabase db push:*)",
      "Bash(pnpm exec supabase db push:*)",
      "Bash(*wrangler deploy:*)",
      "Bash(*wrangler versions deploy:*)",
      "Bash(*wrangler versions upload:*)",
      "Bash(*wrangler secret put:*)",
      "Bash(*wrangler secret bulk:*)",
      "Bash(*wrangler secret delete:*)",
      "Bash(*wrangler pages deploy:*)",
      "Bash(*wrangler pages publish:*)",
      "Bash(*wrangler pages project create:*)",
      "Bash(*wrangler pages project delete:*)",
      "Bash(*wrangler pages secret put:*)",
      "Bash(*wrangler pages secret bulk:*)",
      "Bash(*wrangler pages secret delete:*)",
      "Bash(*wrangler delete:*)",
      "Bash(*wrangler rollback:*)",
      "Bash(*wrangler triggers deploy:*)",
      "Bash(*wrangler login:*)",
      "Bash(*supabase db push:*)",
      "Bash(*supabase migration up *--linked*)",
      "Bash(*supabase migration up *--db-url*)",
      "Bash(*supabase db reset *--linked*)",
      "Bash(*supabase db reset *--db-url*)",
      "Bash(*supabase functions deploy:*)",
      "Bash(*supabase functions delete:*)",
      "Bash(*supabase secrets set:*)",
      "Bash(*supabase secrets unset:*)",
      "Bash(*supabase config push:*)",
      "Bash(*supabase link:*)",
      "Bash(*supabase login:*)",
      "Bash(*supabase projects delete:*)",
      "Bash(git *push *--force*)",
      "Bash(git *push *--delete*)",
      "Bash(git *push *--mirror*)",
      "Bash(git *push *--prune*)",
      "Bash(git *push *--no-verify*)",
      "Bash(git *push -f*)",
      "Bash(git *push * -f*)",
      "Bash(git *push -d*)",
      "Bash(git *push * -d*)",
      "Bash(git *push *+*)",
      "Bash(git *push * :m*)",
      "Bash(git *push * :r*)",
      "Bash(git *push * :c*)",
      "Bash(git *commit *--no-verify*)",
      "Bash(git *commit -n*)",
      "Bash(git *commit * -n*)",
      "Bash(git *merge *--no-verify*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(pnpm exec wrangler:*)",
      "Bash(supabase db push:*)",
      "Bash(gh workflow run:*)",
      "Bash(aws:*)",
      "Bash(cdk deploy:*)",
      "Bash(terraform apply:*)",
      "Bash(npm publish:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-stop-gate.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-session-start.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-usage-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-statusline.mjs\""
  }
}
