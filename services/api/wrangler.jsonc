// Worker config (specs/m0-foundations.md §2, §3 D5/D6, §14 S1).
// D1 bindings (specs/d1-demo-slice.md §4.2, §7.1): Durable Objects and R2, repeated in each env block
// (bindings and vars are not inherited). Secrets (set by an operator, never in git): the candidate-token
// private key and the media-link HMAC key (check-staging-secrets). The database login api_login is the
// API_DB Hyperdrive binding in env.staging (ADR-031 amendment 1; its config id is public, created by the founder
// with scripts/ops/staging-worker-secrets.mjs on 2026-10-22); the local stack instead gets the
// API_DB_URL secret on a loopback host (scripts/e2e-local.mjs). env.dev has no Hyperdrive binding.
// The Supabase URL and publishable key are public vars (L-10); empty here, the deploy sets them.
// M1 R5-13: producer of the AI drafting and member invite queues (trace-authoring-<env>, trace-admin-<env>).
// Deploy order: services/api first (the edge service binding targets it).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trace-api",
  "main": "src/index.ts",
  // Newest date the test runtime supports: @cloudflare/vitest-pool-workers 0.23.0 runs
  // workerd 1.20260815.1, so tests and deploys use the same date. From 2026-08-04 on,
  // nodejs_compat is on by default, which the test pool needs.
  "compatibility_date": "2026-08-15",
  // Keep bindings and secrets out of process.env, so only the typed `env` argument sees them
  // (ADR-027 service-role boundary; S1 security review).
  "compatibility_flags": ["nodejs_compat_do_not_populate_process_env"],
  "workers_dev": false,
  // No per-version preview URLs: an old version must not stay reachable after a redeploy.
  "preview_urls": false,
  // No usage telemetry or npm dependency metadata leaves this machine or CI.
  "send_metrics": false,
  "dependencies_instrumentation": { "enabled": false },
  // Workers Logs on (specs/m0b-tenancy.md §1.1 item 9 (c), M0a REVIEW SPEC-F2): Cloudflare is a
  // processor outside India recorded in ADR-027. Only the redacting logger's lines are stored:
  // invocation logs (request URL, headers, client IP) and traces stay off, and query strings are
  // redacted should invocation logs ever return. wrangler inherits this key into every env block;
  // check-boundaries rule 8 pins it and forbids an env override.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false },
  },
  // The deployed commit, reported by GET /health (spec §9.3). 'dev' locally; CI overrides it with
  // `--var VERSION:<40-hex sha>` (spec §7.2). vars are not inherited by env blocks, so each env
  // repeats it. This is a public build identifier, not a secret. SENTRY_DSN_WORKERS (d1 AT-D22) is
  // empty here, so the Sentry SDK stays off; the staging deploy sets it (a DSN is public, a var).
  "vars": { "VERSION": "dev", "SENTRY_DSN_WORKERS": "" },
  "env": {
    "dev": {
      "name": "trace-api-dev",
      "vars": {
        "VERSION": "dev",
        "SENTRY_DSN_WORKERS": "",
        "CANDIDATE_TOKEN_KID": "",
        "CANDIDATE_TOKEN_PUBLIC_JWK": "",
        "CANDIDATE_APP_ORIGIN": "http://localhost:5173",
        "ALLOWED_ORIGINS": "http://localhost:5174",
        "TRACE_ENV": "dev",
        "DEMO_OUTBOX": "1",
        // The local Supabase API URL (supabase start); the publishable key comes from `supabase status`.
        "SUPABASE_URL": "http://127.0.0.1:54321",
        "SUPABASE_PUBLISHABLE_KEY": "",
      },
      "durable_objects": {
        "bindings": [
          { "name": "OUTBOX", "class_name": "DemoOutboxDO" },
          { "name": "MEDIA_LINKS", "class_name": "MediaLinkDO" },
        ],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoOutboxDO", "MediaLinkDO"] }],
      "r2_buckets": [
        // PACKAGES is written at publish; EVIDENCE is read for media fetch (spec §4.2).
        { "binding": "PACKAGES", "bucket_name": "trace-packages-dev" },
        { "binding": "EVIDENCE", "bucket_name": "trace-evidence-dev" },
      ],
      // M1 R5-13: the api enqueues AI drafting jobs and member invite jobs; workers/jobs consumes them.
      "queues": {
        "producers": [
          { "binding": "AUTHORING_QUEUE", "queue": "trace-authoring-dev" },
          { "binding": "ADMIN_QUEUE", "queue": "trace-admin-dev" },
        ],
      },
    },
    "staging": {
      "name": "trace-api-staging",
      "workers_dev": true,
      "vars": {
        "VERSION": "dev",
        "SENTRY_DSN_WORKERS": "",
        "CANDIDATE_TOKEN_KID": "",
        "CANDIDATE_TOKEN_PUBLIC_JWK": "",
        "CANDIDATE_APP_ORIGIN": "https://trace-candidate-staging.pages.dev",
        "ALLOWED_ORIGINS": "https://trace-recruiter-staging.pages.dev",
        "TRACE_ENV": "staging",
        "DEMO_OUTBOX": "1",
        // Set by the staging deploy from the SUPABASE_STAGING_URL and SUPABASE_STAGING_PUBLISHABLE_KEY
        // GitHub variables (both public values).
        "SUPABASE_URL": "",
        "SUPABASE_PUBLISHABLE_KEY": "",
      },
      "durable_objects": {
        "bindings": [
          { "name": "OUTBOX", "class_name": "DemoOutboxDO" },
          { "name": "MEDIA_LINKS", "class_name": "MediaLinkDO" },
        ],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoOutboxDO", "MediaLinkDO"] }],
      "r2_buckets": [
        { "binding": "PACKAGES", "bucket_name": "trace-packages-staging" },
        { "binding": "EVIDENCE", "bucket_name": "trace-evidence-staging" },
      ],
      "queues": {
        "producers": [
          { "binding": "AUTHORING_QUEUE", "queue": "trace-authoring-staging" },
          { "binding": "ADMIN_QUEUE", "queue": "trace-admin-staging" },
        ],
      },
      // Config trace-staging-api-login (scripts/lib/hyperdrive.mjs); the id is public and works only in this account.
      "hyperdrive": [{ "binding": "API_DB", "id": "1063006219694669b2a7417f307164fd" }],
    },
  },
}
