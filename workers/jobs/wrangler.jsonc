// Worker config (specs/m0-foundations.md §2, §3 D5/D6, §14 S1).
// D1 bindings (specs/d1-demo-slice.md §4.2, §7.1): the mirror Queue consumer and producer, R2 evidence
// (read) and the every-minute sweep cron, repeated in each env block (bindings and vars are not
// inherited). No secret on staging: the three jobs database logins are the JOBS_MIRROR_DB, JOBS_QUALITY_DB and
// JOBS_INTEGRITY_DB Hyperdrive bindings in env.staging (ADR-031 amendment 1; their config ids are public, created
// by the founder on 2026-10-22); the local stack instead gets the three loopback URL secrets
// (scripts/e2e-local.mjs). Deploy order: services/api, then workers/jobs, then workers/edge.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trace-jobs",
  "main": "src/index.ts",
  // Newest date the test runtime supports: @cloudflare/vitest-pool-workers 0.23.0 runs
  // workerd 1.20260815.1, so tests and deploys use the same date. From 2026-08-04 on,
  // nodejs_compat is on by default, which the test pool needs.
  "compatibility_date": "2026-08-15",
  // Keep bindings and secrets out of process.env, so only the typed `env` argument sees them
  // (ADR-027 service-role boundary; S1 security review).
  "compatibility_flags": ["nodejs_compat_do_not_populate_process_env"],
  "workers_dev": false,
  // No per-version preview URLs: an old version must not stay reachable after a redeploy.
  "preview_urls": false,
  // No usage telemetry or npm dependency metadata leaves this machine or CI.
  "send_metrics": false,
  "dependencies_instrumentation": { "enabled": false },
  // Workers Logs on (specs/m0b-tenancy.md §1.1 item 9 (c), M0a REVIEW SPEC-F2): Cloudflare is a
  // processor outside India recorded in ADR-027. Only the redacting logger's lines are stored:
  // invocation logs (request URL, headers, client IP) and traces stay off, and query strings are
  // redacted should invocation logs ever return. wrangler inherits this key into every env block;
  // check-boundaries rule 8 pins it and forbids an env override.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false },
  },
  // The deployed commit, reported by GET /health (spec §9.3). 'dev' locally; CI overrides it with
  // `--var VERSION:<40-hex sha>` (spec §7.2). vars are not inherited by env blocks, so each env
  // repeats it. This is a public build identifier, not a secret. SENTRY_DSN_WORKERS (d1 AT-D22) is
  // empty here, so the Sentry SDK stays off; the staging deploy sets it (a DSN is public, a var).
  "vars": { "VERSION": "dev", "SENTRY_DSN_WORKERS": "" },
  "env": {
    "dev": {
      "name": "trace-jobs-dev",
      "vars": { "VERSION": "dev", "SENTRY_DSN_WORKERS": "", "TRACE_ENV": "dev" },
      "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "trace-evidence-dev" }],
      "queues": {
        // Consumer, and producer for the cron sweep re-enqueue, of one queue (spec §7.1, L-18).
        "producers": [{ "binding": "MIRROR_QUEUE", "queue": "trace-session-mirror-dev" }],
        "consumers": [
          {
            "queue": "trace-session-mirror-dev",
            "max_batch_size": 10,
            "max_retries": 5,
            "dead_letter_queue": "trace-session-mirror-dlq-dev",
          },
        ],
      },
      "triggers": { "crons": ["* * * * *"] },
    },
    "staging": {
      "name": "trace-jobs-staging",
      "workers_dev": true,
      "vars": { "VERSION": "dev", "SENTRY_DSN_WORKERS": "", "TRACE_ENV": "staging" },
      "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "trace-evidence-staging" }],
      "queues": {
        "producers": [{ "binding": "MIRROR_QUEUE", "queue": "trace-session-mirror-staging" }],
        "consumers": [
          {
            "queue": "trace-session-mirror-staging",
            "max_batch_size": 10,
            "max_retries": 5,
            "dead_letter_queue": "trace-session-mirror-dlq-staging",
          },
        ],
      },
      "triggers": { "crons": ["* * * * *"] },
      // Configs trace-staging-jobs-{mirror,quality,integrity}-login (scripts/lib/hyperdrive.mjs); public ids.
      "hyperdrive": [
        { "binding": "JOBS_MIRROR_DB", "id": "784e4dee7f0c4119b482340d48f6089d" },
        { "binding": "JOBS_QUALITY_DB", "id": "29d5817a3e7f42c5ab5433f56ce0e4d5" },
        { "binding": "JOBS_INTEGRITY_DB", "id": "e7200fda374f4caf9169b3c3163f636f" },
      ],
    },
  },
}
