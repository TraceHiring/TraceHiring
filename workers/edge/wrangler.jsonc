// Worker config (specs/m0-foundations.md §2, §3 D5/D6, §14 S1).
// D1 bindings (specs/d1-demo-slice.md §4.2, §7.1): Durable Objects, R2, the mirror Queue producer and
// the CandidateRpc service binding, repeated in each env block (bindings and vars are not
// inherited). The edge holds no secret and no TRACE_ENV (L-10, L-11); every var is public.
// Deploy order: services/api, workers/jobs, then workers/edge (a service-binding target first).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trace-edge",
  "main": "src/index.ts",
  // Newest date the test runtime supports: @cloudflare/vitest-pool-workers 0.23.0 runs
  // workerd 1.20260815.1, so tests and deploys use the same date. From 2026-08-04 on,
  // nodejs_compat is on by default, which the test pool needs.
  "compatibility_date": "2026-08-15",
  // Keep bindings and secrets out of process.env, so only the typed `env` argument sees them
  // (ADR-027 service-role boundary; S1 security review).
  "compatibility_flags": ["nodejs_compat_do_not_populate_process_env"],
  "workers_dev": false,
  // No per-version preview URLs: an old version must not stay reachable after a redeploy.
  "preview_urls": false,
  // No usage telemetry or npm dependency metadata leaves this machine or CI.
  "send_metrics": false,
  "dependencies_instrumentation": { "enabled": false },
  // Workers Logs on (specs/m0b-tenancy.md §1.1 item 9 (c), M0a REVIEW SPEC-F2): Cloudflare is a
  // processor outside India recorded in ADR-027. Only the redacting logger's lines are stored:
  // invocation logs (request URL, headers, client IP) and traces stay off, and query strings are
  // redacted should invocation logs ever return. wrangler inherits this key into every env block;
  // check-boundaries rule 8 pins it and forbids an env override.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false },
  },
  // The deployed commit, reported by GET /health (spec §9.3). 'dev' locally; CI overrides it with
  // `--var VERSION:<40-hex sha>` (spec §7.2). vars are not inherited by env blocks, so each env
  // repeats it. This is a public build identifier, not a secret.
  "vars": { "VERSION": "dev" },
  "env": {
    "dev": {
      "name": "trace-edge-dev",
      "vars": {
        "VERSION": "dev",
        // One public JWK, or two during rotation, each with a kid (spec §4.3). Empty until the
        // operator publishes the key; token verification fails closed on an empty value.
        "CANDIDATE_TOKEN_PUBLIC_JWK": "",
        "CANDIDATE_APP_ORIGIN": "http://localhost:5173",
        "MIRROR_TRANSPORT": "queue",
      },
      "durable_objects": {
        "bindings": [
          { "name": "SESSION", "class_name": "SessionDO" },
          { "name": "OTP", "class_name": "InviteOtpDO" },
        ],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO", "InviteOtpDO"] }],
      "r2_buckets": [
        // Edge code only calls get/head on PACKAGES (scripts/check-boundaries.mjs rule 11).
        { "binding": "PACKAGES", "bucket_name": "trace-packages-dev" },
        { "binding": "EVIDENCE", "bucket_name": "trace-evidence-dev" },
      ],
      "queues": {
        "producers": [{ "binding": "MIRROR_QUEUE", "queue": "trace-session-mirror-dev" }],
      },
      "services": [{ "binding": "API", "service": "trace-api-dev", "entrypoint": "CandidateRpc" }],
    },
    "staging": {
      "name": "trace-edge-staging",
      "workers_dev": true,
      "vars": {
        "VERSION": "dev",
        "CANDIDATE_TOKEN_PUBLIC_JWK": "",
        "CANDIDATE_APP_ORIGIN": "https://trace-candidate-staging.pages.dev",
        "MIRROR_TRANSPORT": "queue",
      },
      "durable_objects": {
        "bindings": [
          { "name": "SESSION", "class_name": "SessionDO" },
          { "name": "OTP", "class_name": "InviteOtpDO" },
        ],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO", "InviteOtpDO"] }],
      "r2_buckets": [
        { "binding": "PACKAGES", "bucket_name": "trace-packages-staging" },
        { "binding": "EVIDENCE", "bucket_name": "trace-evidence-staging" },
      ],
      "queues": {
        "producers": [{ "binding": "MIRROR_QUEUE", "queue": "trace-session-mirror-staging" }],
      },
      "services": [
        { "binding": "API", "service": "trace-api-staging", "entrypoint": "CandidateRpc" },
      ],
    },
  },
}
