{
  "name": "@trace/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/generated/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint . --max-warnings=0 && node scripts/build-tokens.mjs --check",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@trace/shared": "workspace:*"
  },
  "devDependencies": {
    "@trace/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
