BEDROCK_MODEL_FIRST_PASS=         # Haiku-class model id available in India region (ABH-87)
BEDROCK_MODEL_ESCALATION=         # Sonnet-class model id
RAZORPAY_KEY_ID=                  # test mode
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SES_FROM_ADDRESS=
SENTRY_DSN=
POSTHOG_KEY=                      # recruiter app only
STT_PROVIDER=mock                 # mock | sarvam | <fallback> (ABH-86)
CODE_RUNNER=mock                  # mock | <vendor> (ABH-88)
