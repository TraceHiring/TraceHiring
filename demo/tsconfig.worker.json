{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"], "strict": true, "noEmit": true, "skipLibCheck": true,
    "isolatedModules": true, "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/worker.tsbuildinfo"
  },
  "include": ["worker", "src/shared"]
}
